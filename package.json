{
  "name": "haunt-plus-desktop",
  "productName": "haunt+",
  "version": "1.0.0",
  "description": "haunt.gg and haunt tools in one Windows app",
  "author": "toutourina",
  "license": "UNLICENSED",
  "private": true,
  "main": "dist/main.js",
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc -p .",
    "start": "node scripts/build.mjs --dev && electron .",
    "dist": "npm run typecheck && npm run build && electron-builder --win --publish never",
    "release": "npm run typecheck && npm run build && electron-builder --win --publish always"
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "koffi": "3.3.3"
  },
  "devDependencies": {
    "electron": "^44.9.2",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "gifenc": "1.0.3",
    "mediabunny": "1.62.1",
    "typescript": "^5.9.3"
  },
  "build": {
    "appId": "site.haunt-tools.desktop",
    "productName": "haunt+",
    "executableName": "haunt-plus",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "artifactName": "haunt-plus-setup.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "haunt+",
      "uninstallDisplayName": "haunt+"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "Toutourina0110",
        "repo": "haunt-plus-releases",
        "releaseType": "release"
      }
    ]
  }
}
